{
  "name": "oxmpl-js-dev",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "postinstall": "npm run build",
    "test": "npm run build && vitest run",
    "pack": "node scripts/build-package.js && cd pkg-bundler && npm pack",
    "publish": "npm run build && cd pkg-bundler && npm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "node --experimental-wasm-modules examples/simple_2d_planning.js"
  },
  "dependencies": {
    "oxmpl-js": "file:."
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5",
    "wasm-pack": "^0.15.0"
  }
}
